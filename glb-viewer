#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

find_java21_home() {
  local candidate=""

  # macOS bundle path from local tooling (preferred)
  candidate="$(ls -d "$ROOT_DIR"/.tooling/jdk-21*/Contents/Home 2>/dev/null | head -n 1 || true)"
  if [[ -n "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  # Generic JDK directory fallback
  candidate="$(ls -d "$ROOT_DIR"/.tooling/jdk-21* 2>/dev/null | head -n 1 || true)"
  if [[ -n "$candidate" ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi

  # macOS system Java selector
  if command -v /usr/libexec/java_home >/dev/null 2>&1; then
    candidate="$(/usr/libexec/java_home -v 21 2>/dev/null || true)"
    if [[ -n "$candidate" ]]; then
      printf '%s\n' "$candidate"
      return 0
    fi
  fi

  # Existing JAVA_HOME if already Java 21+
  if [[ -n "${JAVA_HOME:-}" ]] && command -v "$JAVA_HOME/bin/java" >/dev/null 2>&1; then
    if "$JAVA_HOME/bin/java" -version 2>&1 | grep -Eq 'version "2[1-9]\.|version "[3-9][0-9]\.'; then
      printf '%s\n' "$JAVA_HOME"
      return 0
    fi
  fi

  return 1
}

JAVA21_HOME="$(find_java21_home || true)"
if [[ -z "$JAVA21_HOME" ]]; then
  echo "Error: Java 21+ is required." >&2
  echo "Install JDK 21 and set JAVA_HOME, or place it under .tooling/jdk-21*." >&2
  exit 1
fi

export JAVA_HOME="$JAVA21_HOME"
export PATH="$JAVA_HOME/bin:$PATH"
export GRADLE_USER_HOME="$ROOT_DIR/.gradle"

if [[ $# -eq 0 ]]; then
  exec "$ROOT_DIR/gradlew" runGlbViewer --args="--help"
fi

# Build Gradle --args payload with explicit quoting so file paths with spaces survive.
gradle_args=""
for arg in "$@"; do
  escaped="${arg//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  if [[ -n "$gradle_args" ]]; then
    gradle_args+=" "
  fi
  gradle_args+="\"$escaped\""
done

exec "$ROOT_DIR/gradlew" runGlbViewer --args="$gradle_args"
